# Local dev — copy to .env and adjust (never commit .env).
# make serve loads this file and runs bin/gfs.

GFS_TOPOLOGY=vps
GFS_DATA_DIR=./var/lib/gfs
GFS_LISTEN=:8080

GFS_LOG_FORMAT=text
GFS_LOG_LEVEL=debug

# First admin when the user table is empty (min 8 chars).
# REQUIRED for empty DB. Change before first start — never use this sample in production.
# Fail-closed: empty user table without these env vars refuses to start.
GFS_BOOTSTRAP_ADMIN=admin
GFS_BOOTSTRAP_PASSWORD=REPLACE_ME_min_8_chars
GFS_BOOTSTRAP_ADMIN_NAME=Administrator

# Set false ONLY for plain-HTTP local dev (no TLS). Default is true (Secure).
# Production behind TLS: leave unset to keep the Secure cookie flag on.
GFS_COOKIE_SECURE=false

# Public login: white form only (no crate hero / gfs title / favicon).
# GFS_LOGIN_SIMPLE=true
# Cap POST /login per IP and per username (default 20/1m). 0 disables.
# GFS_LOGIN_RATE_LIMIT=20/1m
# App-bar tag (default "archive door"). Short label. "-" hides.
# GFS_BRAND_SUB="ACME CORP"
# Authenticated footer (default: gfs vX · groot · groot-share). "-" hides.
# GFS_FOOTER="Internal archive"

# Optional
# GFS_MAX_UPLOAD_BYTES=34359738368
# GFS_KEEP_LAST=20
# GFS_MAX_AGE_DAYS=90

# Optional SFTP inbox (groot upload.sftp). Absolute path. Empty = watcher off.
# gfs does not run an SFTP server — OpenSSH/sshd stays operator-managed.
# See https://github.com/hrodrig/groot-selfhosted/tree/main/run/examples/sftp-vps
# GFS_SFTP_INBOX=/home/groot-inbox/inbox
# GFS_SFTP_POLL=30s

# vps-s3 only (uncomment and set topology + creds):
# GFS_TOPOLOGY=vps-s3
# GFS_S3_BUCKET=my-bucket
# GFS_S3_REGION=us-east-1
# GFS_S3_ENDPOINT=
# GFS_S3_PREFIX=captures/
# GFS_S3_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
